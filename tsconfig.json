{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "lib": [
      "DOM",
      "ES2021",
      "DOM.Iterable"
    ],
    "types": [
      "obsidian"
    ]
  },
  "include": [
    "src/**/*.ts"
  ]
}
